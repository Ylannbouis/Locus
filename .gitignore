# Python virtualenv — recreated by scripts/setup.sh / setup.ps1.
# Never commit: it is ~460MB and its shebangs hardcode absolute local paths,
# so it is useless on any other machine.
backend/.venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Node
node_modules/

# Vite production build (regenerated by scripts/package.sh)
frontend/dist/

# Manim's LaTeX/asset cache written next to the backend
backend/media/

# Local bootstrap cache written by the setup scripts
setup_result.json

# OS cruft
.DS_Store
